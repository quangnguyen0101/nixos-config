#!/usr/bin/env bash
# Điều khiển độ sáng màn hình (TUI).
#  - Laptop: brightnessctl (backlight intel, cần udev rule + group video)
#  - Màn ngoài: ddcutil qua DDC/CI nếu monitor hỗ trợ
#  - Fallback: wlsunset (giảm sáng phần mềm) khi màn ngoài không hỗ trợ DDC
#
# Usage: brt   (mở menu TUI)

set -u

STEP=5

laptop_pct() {
    brightnessctl -l 2>/dev/null | awk -F'[()]' '/Current brightness/{print $(NF-1)}' | rg -o '[0-9.]+' | head -1
}

laptop_set() {
    brightnessctl set "${1}%" 2>/dev/null
}

ext_supported() {
    ddcutil detect 2>/dev/null | rg -qi "DDC/CI supported"
}

ext_pct() {
    local cur max
    cur=$(ddcutil getvcp 10 2>/dev/null | sed -n 's/.*current value *= *\([0-9]*\).*/\1/p' | head -1)
    max=$(ddcutil getvcp 10 2>/dev/null | sed -n 's/.*max value *= *\([0-9]*\).*/\1/p' | head -1)
    if [[ -n "$cur" && -n "$max" && "$max" != "0" ]]; then
        echo "$(( cur * 100 / max ))"
    fi
}

ext_set() {
    local pct="$1" cur max val
    cur=$(ddcutil getvcp 10 2>/dev/null | sed -n 's/.*current value *= *\([0-9]*\).*/\1/p' | head -1)
    max=$(ddcutil getvcp 10 2>/dev/null | sed -n 's/.*max value *= *\([0-9]*\).*/\1/p' | head -1)
    [[ -z "$max" || "$max" == "0" ]] && { echo "Không đọc được dải DDC." >&2; return 1; }
    val=$(( pct * max / 100 ))
    ddcutil setvcp 10 "$val" 2>/dev/null
}

wlsunset_set() {
    pkill -x wlsunset 2>/dev/null
    # map % (0-100, 100 = sáng nhất) -> temperature (6500K sáng, 4000K tối)
    local temp=$(( 6500 - (100 - $1) * 25 ))
    [[ $temp -lt 4000 ]] && temp=4000
    wlsunset -t "$temp" &
}

# Hỏi người dùng chọn 1 số trong danh sách, trả về qua stdout. exit 0.
# Menu/prompt được in ra stderr để không làm bẩn stdout (kết quả).
pick() {
    local prompt="$1"; shift
    local opts=("$@") sel i
    while true; do
        echo "$prompt" >&2
        for i in "${!opts[@]}"; do
            echo "  $((i+1))) ${opts[$i]}" >&2
        done
        read -r -p "Chọn (q: thoát): " sel >&2
        [[ "$sel" == [qQ] ]] && exit 0
        if [[ "$sel" =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= ${#opts[@]} )); then
            echo "$sel"
            return
        fi
        echo "Lựa chọn không hợp lệ." >&2
    done
}

read_pct() {
    local pct
    while true; do
        read -r -p "Phần trăm (0-100): " pct >&2
        if [[ "$pct" =~ ^[0-9]+$ ]] && (( pct >= 0 && pct <= 100 )); then
            echo "$pct"
            return
        fi
        echo "Giá trị không hợp lệ." >&2
    done
}

# $1 = pct hiện tại, $2 = tên, trả về pct đích qua biến NEW_PCT
apply_action() {
    local cur="$1" name="$2" act pct
    act=$(pick "Thao tác cho $name:" "Tăng $STEP%" "Giảm $STEP%" "Đặt mức %")
    case "$act" in
        1) NEW_PCT=$(( cur + STEP > 100 ? 100 : cur + STEP ));;
        2) NEW_PCT=$(( cur - STEP < 0 ? 0 : cur - STEP ));;
        3) NEW_PCT=$(read_pct);;
    esac
}

handle() {
    local target="$1" cur
    case "$target" in
        laptop) cur=$(laptop_pct); [[ -z "$cur" ]] && { echo "Không đọc được backlight." >&2; return 1; };;
        ext)    cur=$(ext_pct);    [[ -z "$cur" ]] && { echo "Không đọc được độ sáng màn ngoài." >&2; return 1; };;
    esac
    echo "Độ sáng hiện tại: ${cur}%" >&2
    NEW_PCT=""
    apply_action "$cur" \
        "$(case "$target" in laptop) echo "Laptop";; ext) echo "Màn ngoài";; esac)"
    case "$target" in
        laptop) laptop_set "$NEW_PCT"; cur=$(laptop_pct); echo "→ ${cur}%" >&2;;
        ext)    ext_set "$NEW_PCT";    cur=$(ext_pct);    echo "→ ${cur:-?}%" >&2;;
    esac
}

main() {
    local -a targets=("Laptop")
    if ext_supported; then
        targets+=("Màn ngoài (DDC/CI)")
    else
        targets+=("Màn ngoài (wlsunset fallback)")
    fi

    local sel
    sel=$(pick "Chọn mục tiêu:" "${targets[@]}")

    case "$sel" in
        1) handle laptop;;
        2)
            if ext_supported; then
                handle ext
            else
                echo "Màn ngoài không hỗ trợ DDC/CI — dùng wlsunset (giảm sáng phần mềm)." >&2
                local pct
                pct=$(pick "Độ sáng phần mềm:" "Tăng $STEP%" "Giảm $STEP%" "Đặt mức %")
                local curtarget=50
                case "$pct" in
                    1) wlsunset_set $((curtarget + STEP > 100 ? 100 : curtarget + STEP));;
                    2) wlsunset_set $((curtarget - STEP < 0 ? 0 : curtarget - STEP));;
                    3) wlsunset_set "$(read_pct)";;
                esac
            fi
            ;;
    esac
}

main "$@"
