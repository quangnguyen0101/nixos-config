#!/usr/bin/env bash
# Daemon giữ máy awake: vừa jiggle phím (reset idle timer của shell/compositor)
# vừa giữ systemd-inhibit (chặn logind suspend/IdleAction/đóng lid).
# Đọc cấu hình từ ~/.local/state/keep-awake/ do menu `keep-awake` ghi ra.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/keep-awake"
DUR_FILE="$STATE_DIR/duration"
START_FILE="$STATE_DIR/start"

duration="$(cat "$DUR_FILE" 2>/dev/null || echo 0)"
start="$(cat "$START_FILE" 2>/dev/null || echo 0)"

if [ "$duration" = "inf" ]; then
  sleep_for="infinity"
else
  rem=$(( start + duration - $(date +%s) ))
  [ "$rem" -lt 0 ] && rem=0
  sleep_for="$rem"
fi

# Chắc chắn daemon ydotool (uinput) đang chạy trước khi jiggle
systemctl --user start ydotoold 2>/dev/null || true
SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/.ydotool_socket"
for _ in $(seq 1 20); do
  [ -S "$SOCK" ] && break
  sleep 0.3
done

# Nhấn/nhả phím Left Shift (keycode 42) mỗi 60s
# để reset idle timer của shell/compositor nếu có.
jiggle() {
  while :; do
    sleep 60
    YDOTOOL_SOCKET="$SOCK" @YDOTOOL@ key 42:1 42:0 || true
  done
}
jiggle &
JIG=$!
trap 'kill "$JIG" 2>/dev/null || true' EXIT HUP INT TERM

# Chặn logind: không suspend, không idle-action, không suspend khi đóng lid.
# Khi `sleep $sleep_for` kết thúc, inhibitor tự nhả và daemon thoát.
if [ "$duration" = "inf" ]; then
  @SYSTEMD_INHIBIT@ \
    --what=idle:sleep:handle-lid-switch --mode=block \
    --why="keep-awake (giữ máy awake theo yêu cầu)" \
    sleep infinity
else
  if @SYSTEMD_INHIBIT@ \
    --what=idle:sleep:handle-lid-switch --mode=block \
    --why="keep-awake (giữ máy awake theo yêu cầu)" \
    sleep "$sleep_for"; then
    @NOTIFY_SEND@ -a keep-awake \
      "Hết thời gian giữ-awake" \
      "Máy trở lại trạng thái bình thường" 2>/dev/null || true
  fi
fi